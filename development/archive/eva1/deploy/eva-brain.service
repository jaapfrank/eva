[Unit]
Description=Eva brainservice (ArcFace en beeldencoder)
After=network-online.target

[Service]
WorkingDirectory=/opt/eva
Environment=EVA_ENCODER=/opt/eva/data/runtime/eva-brain-data/encoder_pilot.pt
Environment=EVA_FACE_MODEL_ROOT=/opt/eva/data/runtime/eva-brain-models/insightface
ExecStart=/opt/eva/data/runtime/eva-brain-venv/bin/python -m uvicorn eva_brain.service:app --host 127.0.0.1 --port 3220
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
