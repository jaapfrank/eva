{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "dependencyDashboardApproval": true,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "pin",
  "ignorePaths": [
    "**/build/**",
    "**/evidence/**",
    "**/vendor/**",
    "**/.venv/**"
  ],
  "enabledManagers": [
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "pep621",
    "pip_requirements"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)component-watch\\.json$/"],
      "matchStrings": [
        "\\\"repository\\\":\\s*\\\"(?<depName>[^\\\"]+)\\\",\\s*\\\"currentRelease\\\":\\s*\\\"(?<currentValue>[^\\\"]+)\\\""
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Eva updates are proposals; validation and A/B promotion stay mandatory.",
      "matchManagers": [
        "docker-compose",
        "dockerfile",
        "github-actions",
        "pep621",
        "pip_requirements"
      ],
      "automerge": false,
      "labels": ["dependencies", "needs-eva-validation"]
    },
    {
      "description": "Never mix a breaking update into a routine proposal.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Container references remain content-addressed.",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "A new competitor release reopens the comparable benchmark gate.",
      "matchFileNames": ["component-watch.json"],
      "matchDepNames": [
        "openclaw/openclaw",
        "NousResearch/hermes-agent",
        "agent0ai/agent-zero"
      ],
      "labels": ["competition", "benchmark-required"],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
