{
  "name": "eva-homebot",
  "version": "1.0.0",
  "description": "Eva - een digitale huisgenoot met gesprek, geheugen, gereedschap en eigen initiatief",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "EVA_DATA_DIR=\"${EVA_DATA_DIR:-./data}\" node src/index.js",
    "login": "EVA_DATA_DIR=\"${EVA_DATA_DIR:-./data}\" node src/brain/oauth.js",
    "test": "npm run test:all",
    "test:all": "./scripts/run-isolated-tests-bootstrap test/*.test.js test/*.test.mjs scripts/*.test.mjs",
    "architecture": "node scripts/generate-runtime-contract-map.mjs && node scripts/generate-repository-inventory.mjs",
    "architecture:check": "node scripts/generate-runtime-contract-map.mjs --check && node scripts/generate-repository-inventory.mjs --check",
    "typecheck": "node scripts/quality-gate.mjs typecheck",
    "lint": "node scripts/quality-gate.mjs lint",
    "complexity": "node scripts/quality-gate.mjs complexity",
    "coverage": "./scripts/run-isolated-tests-bootstrap --coverage test/*.test.js test/*.test.mjs scripts/*.test.mjs",
    "quality": "npm run architecture:check && npm run typecheck && npm run lint && npm run complexity && npm run coverage"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "grammy": "^1.30.0",
    "three": "^0.179.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "^5.9.3"
  }
}
