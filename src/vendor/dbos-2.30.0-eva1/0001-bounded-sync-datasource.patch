+class _TransactionRecoveryRequired(DBOSBaseException):
+    """Leave an ambiguous datasource step pending for supervised recovery.
+
+    ``BaseException`` control flow is intentional: DBOS must not checkpoint a
+    guessed error in either datasource or system storage while commit outcome is
+    unknown.  A recovered workflow starts with the datasource output pre-check.
+    """
+
+
+def _validate_max_transaction_attempts(value: int) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value < 1:
+        raise DBOSException("max_transaction_attempts must be an integer >= 1")
+    return value
+
