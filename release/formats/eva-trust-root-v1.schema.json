{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eva:release:Eva2TrustRoot:v1",
  "title": "Eva2TrustRoot/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "rootVersion", "validFrom", "threshold", "keys", "previousRootSignatures"],
  "properties": {
    "contract": {"const": "Eva2TrustRoot/v1"},
    "rootVersion": {"type": "integer", "minimum": 1},
    "validFrom": {"type": "string", "format": "date-time"},
    "threshold": {"type": "integer", "minimum": 1},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "algorithm", "publicKeyBase64", "roles", "validFrom", "validUntil"],
        "properties": {
          "keyId": {"type": "string", "minLength": 1, "maxLength": 128},
          "algorithm": {"const": "Ed25519"},
          "publicKeyBase64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
          "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["offline_root", "release_signer", "connector_artifact_signer", "connector_promotion_signer"]}},
          "validFrom": {"type": "string", "format": "date-time"},
          "validUntil": {"type": "string", "format": "date-time"}
        }
      }
    },
    "previousRootSignatures": {"type": "array", "items": {"$ref": "eva-signature-envelope-v1.schema.json"}}
  }
}
