{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eva:release:Eva2BuildProvenance:v1",
  "title": "Eva2BuildProvenance/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "buildInputsSha256", "builderId", "builderImageDigest", "startedAt", "finishedAt", "artifactSha256", "materials", "network", "productionCredentialsPresent", "reproducibilitySetId"],
  "properties": {
    "contract": {"const": "Eva2BuildProvenance/v1"},
    "buildInputsSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "builderId": {"type": "string", "minLength": 1, "maxLength": 128},
    "builderImageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": "string", "format": "date-time"},
    "artifactSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materials": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "network": {"enum": ["allowlisted_artifact_proxy", "none"]},
    "productionCredentialsPresent": {"const": false},
    "reproducibilitySetId": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
