# Non-secret Living Core connector configuration. Secret bytes are mounted as
# read-only files and are never placed in this environment file.
EVA_AGENTMAIL_INBOX_ID=eva@example.agentmail.to
EVA_AGENTMAIL_API_KEY_FILE=/run/secrets/eva-agentmail-api-key

# Full-stack Compose host bindings. Secret files are provisioned separately and
# never copied into an image or committed to this repository. The DSN file must
# be owned/readable by container UID 65532 with no group/other access; the
# PostgreSQL password file remains root-owned mode 0600.
EVA_LIVING_CORE_IMAGE=eva2-living-core@sha256:<content-addressed-image-id>
# Read-only preflight identity. There is no apply/recreate path until the
# current unmanaged B has a separately reviewed complete manifest/adoption.
EVA_B_COMPOSE_PROJECT=eva2-b-live
EVA_STACK_CORE_CONTAINER=eva2-living-core-b
# Fixed trust anchor; wrappers and alternative executables are refused.
EVA_B_DOCKER_BINARY=/usr/bin/docker
EVA_B_DOCKER_CONFIG_DIR=/run/eva2/docker-config
EVA_B_DOCKER_CONTEXT=eva2-b-local
EVA_B_DOCKER_DAEMON=unix:///var/run/docker.sock
EVA_CODEX_AUTH_DIR=/run/eva2/codex-auth
EVA_MODEL_ACCESS_LEASE_DIR=/run/eva2/model-access-lease
EVA_HINDSIGHT_ACCESS_DIR=/run/eva2/hindsight-access
EVA_STACK_WORK_VOLUME=eva2-living-work-b
EVA_POSTGRES_PASSWORD_FILE_HOST=/run/eva2/secrets/postgres-password
EVA_DATABASE_DSN_FILE_HOST=/run/eva2/secrets/database-dsn
EVA_STACK_BIND_ADDRESS=127.0.0.1
EVA_STACK_CORE_PORT=44674
EVA_STACK_MODEL_LEASE_CONTAINER=eva2-model-access-lease
EVA_STACK_HINDSIGHT_LEASE_CONTAINER=eva2-hindsight-access-lease
EVA_STACK_POSTGRES_DATABASE=eva2
EVA_STACK_POSTGRES_VOLUME=eva2-postgres-b-live
EVA_STACK_HINDSIGHT_VOLUME=eva2-hindsight-memory
EVA_HINDSIGHT_BANK_NAMESPACE=eva2
EVA_IDENTITY_NAME=Eva
EVA_IDENTITY_DESCRIPTION=Je bent een warme, nuchtere en capabele digitale huisgenoot.
EVA_CONVERSATION_REASONING_EFFORT=medium
EVA_FILE_BATCH_ROOT=/var/lib/eva/work

# Capability-preservation declarations required by the read-only B preflight.
# They are not yet a deployable complete current-B manifest.
EVA_FANOUT_RECIPIENT_ENDPOINTS_JSON={"owner":"https://delivery.example/eva"}
EVA_FANOUT_ALLOW_INSECURE_HTTP=false

# Add home-assistant.compose.yml when this installation controls a household.
# EVA_HOME_ASSISTANT_TOKEN is forbidden here. The runtime requires the file to
# be absolute, regular/non-symlink, <=64 KiB, non-empty UTF-8, owned by its
# effective UID 65532, and free of every group/other permission bit.
EVA_HOME_ASSISTANT_URL=http://homeassistant.local:8123
EVA_HOME_ASSISTANT_TOKEN_FILE_HOST=/run/eva2/secrets/home-assistant-token
EVA_HOME_ASSISTANT_EVENT_DOMAINS=light,sensor,binary_sensor,climate,person
EVA_RUNTIME_TENANT_ID=household-tenant
EVA_RUNTIME_INSTALLATION_ID=household-installation
EVA_RUNTIME_PRINCIPAL_ID=household-owner

# Optional outbound-only proactive delivery. Add telegram-proactive.compose.yml
# only after the owner explicitly approves the destination chat.
EVA_TELEGRAM_PROACTIVE_CHAT_ID=123456789
EVA_TELEGRAM_BOT_TOKEN_FILE_HOST=/run/eva2/secrets/telegram-bot-token
# Used only by the opt-in telegram-native profile. This file and the database
# DSN/token files must be UID 65532-owned and mode 0600 (or 0400).
EVA_TELEGRAM_PRINCIPAL_BINDINGS_FILE_HOST=/run/eva2/secrets/telegram-principal-bindings.json

# Optional bounded goals. The core only admits exact wake conditions and the
# separate worker owns waiting, re-read, one effect and one delivery. Plain HTTP
# is test-only and requires the explicit insecure switch.
EVA_DURABLE_GOAL_PROVIDER=example-provider
EVA_DURABLE_GOAL_PROVIDER_URL=https://provider.example/v1
EVA_DURABLE_GOAL_RECIPIENTS=owner-channel
EVA_DURABLE_GOAL_POLL_SECONDS=2
EVA_DURABLE_GOAL_TIMEOUT_SECONDS=5
EVA_DURABLE_GOAL_ALLOW_INSECURE_HTTP=false

# Optional commercial publication. Start with a Stripe test account and merge
# commerce-stripe.compose.yml. Switching to true is a separate owner decision;
# the runtime rejects a test/live key mismatch before provider contact.
EVA_STRIPE_ACCOUNT_ID=acct_exact_account_id
EVA_COMMERCE_PUBLIC_BASE_URL=https://eva.example.nl
EVA_STRIPE_LIVE_MODE=false
EVA_STRIPE_SECRET_KEY_FILE_HOST=/run/eva2/secrets/stripe-secret-key
EVA_STRIPE_WEBHOOK_SECRET_FILE_HOST=/run/eva2/secrets/stripe-webhook-secret
