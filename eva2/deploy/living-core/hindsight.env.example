# Non-secret Hindsight hot-path limits for Eva's B/production deployment.
# Keep semantic, graph and temporal retrieval plus cross-encoder quality, but
# never score the full hundred-plus candidate set on the conversational path.
HINDSIGHT_API_RERANKER_MAX_CANDIDATES_LOW=32

# Host-side Compose settings. Only the publisher reads the single credential
# authority; Hindsight itself receives an access-only file through a read-only
# mount. Neither directory is copied into an image or repository.
EVA_LIVING_CORE_IMAGE=eva2-living-core@sha256:<content-addressed-image-id>
EVA_CODEX_AUTH_DIR=/run/eva2/codex-auth
EVA_HINDSIGHT_ACCESS_DIR=/run/eva2/hindsight-access
EVA_HINDSIGHT_LEASE_CONTAINER=eva2-hindsight-access-lease
EVA_HINDSIGHT_BIND_ADDRESS=127.0.0.1
EVA_HINDSIGHT_PORT=44672
EVA_HINDSIGHT_CONTAINER_NAME=eva2-hindsight-memory
EVA_HINDSIGHT_DATA_VOLUME=eva2-hindsight-memory
EVA_HINDSIGHT_WORKER_ID=eva2-hindsight-memory
