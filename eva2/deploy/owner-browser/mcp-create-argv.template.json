[
  "docker",
  "create",
  "--name",
  "${INSTANCE}-mcp",
  "--pull",
  "never",
  "--network",
  "container:${BROWSER_CONTAINER_ID}",
  "--read-only",
  "--user",
  "1000:1000",
  "--cap-drop",
  "ALL",
  "--security-opt",
  "no-new-privileges",
  "--cpus",
  "1",
  "--memory",
  "512m",
  "--pids-limit",
  "128",
  "--tmpfs",
  "/tmp:rw,nosuid,size=64m,mode=1777",
  "--tmpfs",
  "/home/node:rw,nosuid,size=64m,uid=1000,gid=1000,mode=0700",
  "--label",
  "io.eva2.browser-candidate=${INSTANCE}",
  "--health-cmd",
  "node -e \"require('http').get('http://127.0.0.1:8931/mcp',r=>{const ok=[200,400,405,406].includes(r.statusCode);r.destroy();process.exit(ok?0:1)}).on('error',()=>process.exit(1))\"",
  "--health-interval",
  "3s",
  "--health-timeout",
  "4s",
  "--health-start-period",
  "5s",
  "--health-retries",
  "3",
  "--entrypoint",
  "node",
  "mcr.microsoft.com/playwright/mcp@sha256:e3f6a85f0fd771dd9440584bd905011f1b4ea25b115bfea8b796d17d23e7b767",
  "/app/cli.js",
  "--cdp-endpoint",
  "http://127.0.0.1:9222",
  "--shared-browser-context",
  "--host",
  "0.0.0.0",
  "--port",
  "8931",
  "--allowed-hosts",
  "192.168.0.2:8931,127.0.0.1:8931",
  "--image-responses",
  "omit",
  "--codegen",
  "none",
  "--output-dir",
  "/tmp/mcp-output"
]
