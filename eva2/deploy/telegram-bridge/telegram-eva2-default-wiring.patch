+async function respondWithEva2(ctx, mediaContext = null) {
+  const archivedMessage = telegramMessage(ctx.chat.id, ctx.message.message_id);
+  try {
+    const draftSink = createEva2DraftSink({
+      chatId: ctx.chat.id, draftId: ctx.message.message_id,
+      sendDraft: bot?.api?.raw?.sendMessageDraft?.bind(bot.api.raw),
+    });
+    const answer = await askEva2Canary({
+      baseUrl: config.eva2CanaryUrl, chatId: ctx.chat.id,
+      messageId: ctx.message.message_id, fromId: ctx.from.id,
+      text: telegramMessageContent(ctx.message), archivedMessage, mediaContext,
+      telegramDate: ctx.message.date,
+      onDraft: draftSink ? draftSink.map(labelEva2TelegramReply) : null,
+      onReceipt: draftSink ? (text) => draftSink.receipt(text) : null,
+    });
+    if (!answer) throw new Error('Bericht hoort niet bij Eva2');
+    await sendTelegramText(ctx.chat.id, labelEva2TelegramReply(answer.text), {
+      replyToMessageId: ctx.message.message_id,
+      dedupeKey: inboundReplyDedupeKey(ctx, 'eva2-canary'),
+    });
+  } catch (error) {
+    await sendTelegramText(ctx.chat.id, labelEva2TelegramFailure(errMsg(error).slice(0, 160)), {
+      replyToMessageId: ctx.message.message_id,
+      dedupeKey: inboundReplyDedupeKey(ctx, 'eva2-canary-error'),
+    });
+  }
+}
+
+async function respondWithEva2Photo(ctx, file) {
+  try {
+    const archived = telegramMessage(ctx.chat.id, ctx.message.message_id);
+    let mediaContext = archived.meta?.eva2MediaContext || null;
+    if (!mediaContext) {
+      const buffer = await downloadTelegramFile(ctx, file.file_id);
+      mediaContext = await analyseEva2Photo({
+        buffer, contentType: file.mime_type || 'image/jpeg',
+        sourceRef: 'telegram:' + ctx.chat.id + ':' + ctx.message.message_id,
+        caption: ctx.message.caption || '',
+        complete: chatComplete, imageMessage: imageMsg,
+      });
+      archiveTelegramMessage({ chatId: ctx.chat.id, messageId: ctx.message.message_id,
+        meta: { ...archived.meta, eva2MediaContext: mediaContext } });
+    }
+    await respondWithEva2(ctx, mediaContext);
+  } catch (error) {
+    await sendTelegramText(ctx.chat.id, labelEva2TelegramFailure(errMsg(error).slice(0, 160)), {
+      replyToMessageId: ctx.message.message_id,
+      dedupeKey: inboundReplyDedupeKey(ctx, 'eva2-canary-error'),
+    });
+  }
+}
