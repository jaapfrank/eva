+def validate_eva_transport(config):
+    if not config[CONF_EVA_PCM_PROTOCOL]:
+        if CONF_EVA_CREDENTIAL in config or CONF_EVA_SERVER_CA in config:
+            raise cv.Invalid("Eva credentials require eva_pcm_protocol")
+        return config
+    endpoint = urlsplit(config[CONF_URL])
+    if (endpoint.scheme != "wss" or not endpoint.hostname or endpoint.username or endpoint.password
+            or endpoint.path != "/eva-speaker/v1" or endpoint.query or endpoint.fragment
+            or config[CONF_AUTO_PROVISION]):
+        raise cv.Invalid("Eva requires a fixed wss endpoint at /eva-speaker/v1 and auto_provision: false")
+    if not re.fullmatch(r"[A-Za-z0-9_-]{43}", config.get(CONF_EVA_CREDENTIAL, "")):
+        raise cv.Invalid("Eva requires a provisioned 32-byte base64url credential")
+    certificate = config.get(CONF_EVA_SERVER_CA, "")
+    if (not certificate.startswith("-----BEGIN CERTIFICATE-----") or
+            "-----END CERTIFICATE-----" not in certificate or len(certificate) > 8192):
+        raise cv.Invalid("Eva requires a PEM server CA certificate")
+    return config
