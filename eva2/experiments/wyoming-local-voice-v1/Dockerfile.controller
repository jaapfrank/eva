# Disposable controller used only to prove that the local voice sidecars can
# communicate over an internal Docker network.  It is not Eva's product image.
FROM python:3.12-slim@sha256:a249c9f47e05708dd367f3fe8ada03cf347390fad66fb8b0518c0ef55ae3cb84

ENV PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY experiments/wyoming-local-voice-v1/requirements.lock /tmp/requirements.lock
# The experiment receives a separately prepared wheelhouse as a BuildKit named
# context.  A voice image must not silently fetch PyPI packages while it is
# being rebuilt; the lock is necessary but not sufficient for that guarantee.
COPY --from=wheelhouse / /wheelhouse
RUN python -m pip install --no-cache-dir --no-index --only-binary=:all: \
    --find-links=/wheelhouse --require-hashes -r /tmp/requirements.lock \
    && rm -rf /wheelhouse

COPY src/eva /app/src/eva
COPY experiments/wyoming-local-voice-v1 /app/experiments/wyoming-local-voice-v1

WORKDIR /app/experiments/wyoming-local-voice-v1
ENTRYPOINT ["python", "run_pipeline.py"]
