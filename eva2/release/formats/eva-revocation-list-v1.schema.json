{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eva:release:Eva2RevocationList:v1",
  "title": "Eva2RevocationList/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "sequence", "trustRootVersion", "issuedAt", "expiresAt", "minimumSupportedRelease", "entries", "signatures"],
  "properties": {
    "contract": {"const": "Eva2RevocationList/v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "trustRootVersion": {"type": "integer", "minimum": 1},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "minimumSupportedRelease": {"type": "string", "minLength": 1, "maxLength": 64},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subjectKind", "subjectId", "effectiveAt", "reason"],
        "properties": {
          "subjectKind": {"enum": ["key", "release", "image", "connector_artifact", "connector_promotion"]},
          "subjectId": {"type": "string", "minLength": 1, "maxLength": 256},
          "subjectSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "effectiveAt": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "signatures": {"type": "array", "minItems": 1, "items": {"$ref": "eva-signature-envelope-v1.schema.json"}}
  }
}
