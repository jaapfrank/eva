{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eva:release:Eva2ReleaseManifest:v1",
  "title": "Eva2ReleaseManifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "releaseId", "releaseVersion", "minimumSupportedRelease", "sourceCommit", "platformLockSha256", "imageDigests", "sbomBindings", "licenseInventorySha256", "provenanceSha256", "schemaSetSha256", "migrationRevision", "compatibleSchemaRevisions", "revocationSequence", "signatures"],
  "properties": {
    "contract": {"const": "Eva2ReleaseManifest/v1"},
    "releaseId": {"type": "string", "minLength": 1, "maxLength": 256},
    "releaseVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "minimumSupportedRelease": {"type": "string", "minLength": 1, "maxLength": 64},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "platformLockSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "imageDigests": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "sbomBindings": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "licenseInventorySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenanceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schemaSetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "migrationRevision": {"type": "string", "minLength": 1, "maxLength": 128},
    "compatibleSchemaRevisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "revocationSequence": {"type": "integer", "minimum": 1},
    "signatures": {"type": "array", "minItems": 1, "items": {"$ref": "eva-signature-envelope-v1.schema.json"}}
  }
}
