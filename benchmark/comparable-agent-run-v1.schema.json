{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eva.local/benchmark/ComparableAgentRun-v1.schema.json",
  "title": "ComparableAgentRun/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter",
    "agent",
    "artifacts",
    "benchmark",
    "contract",
    "environment",
    "execution",
    "model",
    "result",
    "runId",
    "upstream"
  ],
  "properties": {
    "contract": {"const": "ComparableAgentRun/v1"},
    "runId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"},
    "benchmark": {"enum": ["agentbench_fc", "gaia", "osworld_2"]},
    "upstream": {"$ref": "#/$defs/upstream"},
    "agent": {"$ref": "#/$defs/agent"},
    "adapter": {"$ref": "#/$defs/adapter"},
    "model": {"$ref": "#/$defs/model"},
    "execution": {"$ref": "#/$defs/execution"},
    "environment": {"$ref": "#/$defs/environment"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "result": {"$ref": "#/$defs/result"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,239}@sha256:[0-9a-f]{64}$"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 240},
    "upstream": {
      "type": "object", "additionalProperties": false,
      "required": ["assetsRevision", "datasetRevision", "release", "repository", "scorerSha256", "sourceCommitSha256"],
      "properties": {
        "assetsRevision": {"$ref": "#/$defs/revision"},
        "datasetRevision": {"$ref": "#/$defs/revision"},
        "release": {"$ref": "#/$defs/revision"},
        "repository": {"type": "string", "pattern": "^https://"},
        "scorerSha256": {"$ref": "#/$defs/sha256"},
        "sourceCommitSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["commitSha256", "id", "imageDigest"],
      "properties": {
        "commitSha256": {"$ref": "#/$defs/sha256"},
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"},
        "imageDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "version"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {"$ref": "#/$defs/revision"}
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "provider", "reasoning", "revision", "temperature"],
      "properties": {
        "id": {"$ref": "#/$defs/revision"},
        "provider": {"$ref": "#/$defs/revision"},
        "reasoning": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]},
        "temperature": {"type": ["number", "null"], "minimum": 0, "maximum": 2}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["contextTokenLimit", "costEuroMicrosLimit", "mode", "networkPolicy", "retryLimit", "seed", "stepLimit", "timeLimitSeconds"],
      "properties": {
        "contextTokenLimit": {"type": "integer", "minimum": 1},
        "costEuroMicrosLimit": {"type": "integer", "minimum": 0},
        "mode": {"enum": ["native", "controlled"]},
        "networkPolicy": {"enum": ["benchmark_required", "none", "recorded_allowlist"]},
        "retryLimit": {"type": "integer", "minimum": 0, "maximum": 20},
        "seed": {"type": "integer", "minimum": 0},
        "stepLimit": {"type": "integer", "minimum": 1},
        "timeLimitSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["browserOrVmImageDigest", "hardwareClass", "osImageDigest"],
      "properties": {
        "browserOrVmImageDigest": {"$ref": "#/$defs/digest"},
        "hardwareClass": {"$ref": "#/$defs/revision"},
        "osImageDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"enum": ["answers", "runner_log", "screenshot_or_video_index", "tool_trace"]},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]{0,239}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["humanInterventionCount", "officialScore", "status", "totalCostEuroMicros", "totalTokenCount", "wallTimeSeconds"],
      "properties": {
        "humanInterventionCount": {"type": ["integer", "null"], "minimum": 0},
        "officialScore": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "status": {"enum": ["planned", "executed"]},
        "totalCostEuroMicros": {"type": ["integer", "null"], "minimum": 0},
        "totalTokenCount": {"type": ["integer", "null"], "minimum": 0},
        "wallTimeSeconds": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
