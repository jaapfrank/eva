{
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.4-mini"
      },
      "models": {
        "openai/gpt-5.4-mini": {
          "agentRuntime": {
            "id": "codex"
          }
        }
      }
    }
  },
  "plugins": {
    "allow": ["codex"],
    "entries": {
      "codex": {
        "config": {
          "appServer": {
            "homeScope": "user"
          }
        },
        "enabled": true
      }
    }
  },
  "tools": {
    "exec": {
      "mode": "auto"
    }
  }
}
