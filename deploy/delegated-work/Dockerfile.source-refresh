# Source-only update: explicitly select the actual current immutable worker.
ARG PROVEN_WORKER_IMAGE
FROM ${PROVEN_WORKER_IMAGE}

ARG SOURCE_COMMIT
ARG SOURCE_DATE_EPOCH

LABEL io.eva2.source-commit=${SOURCE_COMMIT} \
      io.eva2.source-date-epoch=${SOURCE_DATE_EPOCH} \
      io.eva2.source-refresh="git-archive-v1"

COPY --chown=65532:65532 src /opt/eva/src

USER 65532:65532
