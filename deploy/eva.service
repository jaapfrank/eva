[Unit]
Description=Eva digitale huisentiteit
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=eva
Group=eva
SupplementaryGroups=eva-runtime-read
WorkingDirectory=/opt/eva
Environment=EVA_DATA_DIR=/opt/eva/data
ExecStart=/usr/bin/node /opt/eva/src/index.js
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
UnsetEnvironment=EVA_WEB_TOKEN WEB_HOST
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eva

[Install]
WantedBy=multi-user.target
