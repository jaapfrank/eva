[Unit]
Description=Eva2 continuous household speaker
BindsTo=eva.service
PartOf=eva.service
After=eva.service network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
User=eva2-speaker
Group=eva2-speaker
RuntimeDirectory=eva2-native-speaker
RuntimeDirectoryMode=0700
LoadCredential=config.json:/etc/native-speaker/config.json
LoadCredential=tls.crt:/etc/native-speaker/tls.crt
LoadCredential=tls.key:/etc/native-speaker/tls.key
ExecStart=/usr/bin/python3.12 -I -S -B /opt/native-speaker/current/backup/history/eva2/experiments/native-duplex-v1/service_launcher.py
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=
UMask=0077

# Activation adds Wants=eva2-native-speaker.service to eva.service. Install the
# complete reviewed core/bundle together; no standalone enable or old-core fallback.
