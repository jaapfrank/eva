[Unit]
Description=Eva2 native household voice ingress
BindsTo=eva.service
PartOf=eva.service
After=eva.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eva2-voice
Group=eva2-voice
RuntimeDirectory=eva2-voice-ingress
RuntimeDirectoryMode=0700
EnvironmentFile=/etc/voice-ingress.env
ExecStartPre=/usr/bin/python3 /opt/eva2/voice-ingress/render_household_voice_ingress.py --listen ${EVA_VOICE_LISTEN_ADDRESS} --home-assistant ${EVA_VOICE_HA_ADDRESS}
ExecStartPre=/opt/eva2/voice-ingress/nginx -t -c /run/eva2-voice-ingress/nginx.conf -e stderr
ExecStart=/opt/eva2/voice-ingress/nginx -c /run/eva2-voice-ingress/nginx.conf -e stderr
KillSignal=SIGTERM
TimeoutStopSec=5
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=
UMask=0077

# Installation adds Wants=eva2-voice-ingress.service to eva.service. Consequently
# the existing stop/switch/start cutover closes voice before copying data, then
# renders the selected slot on restart. Do not enable this service independently.
