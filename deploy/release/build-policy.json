{
  "contract": "Eva2BuildPolicy/v1",
  "status": "input_format_selected_no_build_executed",
  "buildInputsSchema": "deploy/release/formats/eva-build-inputs-v1.schema.json",
  "buildProvenanceSchema": "deploy/release/formats/eva-build-provenance-v1.schema.json",
  "sourceTreeMustBeClean": true,
  "sourceCommitRequired": true,
  "sourceDateEpochRequired": true,
  "dependencyFetch": {
    "networkMode": "allowlisted_content_addressed_artifact_proxy_only",
    "hashLockRequired": true,
    "productionCredentialsAllowed": false
  },
  "compileAndPackage": {
    "generalNetworkAllowed": false,
    "productionCredentialsAllowed": false,
    "undeclaredInputsAllowed": false,
    "absoluteWorktreePathsAllowed": false
  },
  "reproducibility": {
    "independentCleanBuildersRequired": 2,
    "byteIdenticalPreferred": true,
    "declaredSemanticEquivalenceAllowed": true,
    "nonDeterministicMetadataOutsideSignedPayload": true
  },
  "claims": {
    "cleanBuildExecuted": false,
    "twoBuilderReproducibilityProven": false,
    "releaseArtifactExists": false
  }
}
