+    def _reload_external_access_lease(self) -> None:
+        """Read one owned access-only snapshot; never retain stale authority."""
+        import fcntl
+        import math
+        import stat
+
+        directory = lock = auth = None
+        try:
+            path = self._auth_file
+            if not path.is_absolute() or ".." in path.parts or path.name != "auth.json":
+                raise ValueError("Unexpected access lease path")
+            parent = path.parent.lstat()
+            uid, gid = os.geteuid(), os.getegid()
+            if (not stat.S_ISDIR(parent.st_mode) or stat.S_IMODE(parent.st_mode) != 0o700
+                    or parent.st_uid != uid or parent.st_gid != gid):
+                raise ValueError("Unsafe access lease directory")
+            flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
+            directory = os.open(path.parent, flags | os.O_DIRECTORY)
+            identity = lambda value: (value.st_dev, value.st_ino, value.st_mode,
+                                      value.st_uid, value.st_gid, value.st_nlink,
+                                      value.st_size, value.st_mtime_ns, value.st_ctime_ns)
+            if identity(os.fstat(directory)) != identity(parent):
+                raise ValueError("Access lease directory changed")
+            lock_name = path.with_suffix(".lock").name
+            lock = os.open(lock_name, flags, dir_fd=directory)
+            lock_before = os.fstat(lock)
+            if (not stat.S_ISREG(lock_before.st_mode) or lock_before.st_nlink != 1
+                    or lock_before.st_uid != uid or lock_before.st_gid != gid
+                    or stat.S_IMODE(lock_before.st_mode) != 0o600 or lock_before.st_size != 0):
+                raise ValueError("Unsafe access lease lock")
+            fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
+            auth = os.open(path.name, flags, dir_fd=directory)
+            before = os.fstat(auth)
+            if (not stat.S_ISREG(before.st_mode) or before.st_nlink != 1
+                    or before.st_uid != uid or before.st_gid != gid
+                    or stat.S_IMODE(before.st_mode) != 0o600 or not 0 < before.st_size <= 65536):
+                raise ValueError("Unsafe access lease file")
+            pieces = []
+            size = 0
+            while size <= 65536:
+                piece = os.read(auth, min(4096, 65537 - size))
+                if not piece:
+                    break
+                pieces.append(piece)
+                size += len(piece)
+            if size > 65536 or size != before.st_size:
+                raise ValueError("Access lease size changed")
+            if (identity(os.fstat(auth)) != identity(before)
+                    or identity(os.stat(path.name, dir_fd=directory, follow_symlinks=False)) != identity(before)
+                    or identity(os.fstat(lock)) != identity(lock_before)
+                    or identity(os.stat(lock_name, dir_fd=directory, follow_symlinks=False)) != identity(lock_before)
+                    or identity(path.parent.lstat()) != identity(parent)):
+                raise ValueError("Access lease snapshot changed")
+            value = json.loads(b"".join(pieces))
+            tokens = value.get("tokens") if isinstance(value, dict) else None
+            if (not isinstance(tokens, dict) or set(value) != {"auth_mode", "tokens"}
+                    or value["auth_mode"] != "chatgpt"
+                    or set(tokens) != {"access_token", "account_id"}
+                    or any(not isinstance(tokens[k], str) or not tokens[k] for k in tokens)):
+                raise ValueError("Access lease is unavailable or contains extra authority")
+            token = tokens["access_token"]
+            parts = token.split(".")
+            if len(parts) == 3:
+                payload = base64.b64decode(parts[1] + "=" * (-len(parts[1]) % 4),
+                                           altchars=b"-_", validate=True)
+                claims = json.loads(payload)
+                if not isinstance(claims, dict):
+                    raise ValueError("Invalid declared JWT payload")
+                if "exp" in claims:
+                    expiry = claims["exp"]
+                    if (type(expiry) not in (int, float) or not math.isfinite(float(expiry))
+                            or expiry <= time.time()):
+                        raise ValueError("Access lease expired")
+            self._auth_manager.access_token = token
+            self._auth_manager.account_id = tokens["account_id"]
+            self._auth_manager.refresh_token = None
+        except (OSError, ValueError, UnicodeError, OverflowError, RecursionError):
+            self._auth_manager.access_token = ""
+            self._auth_manager.account_id = ""
+            self._auth_manager.refresh_token = None
+            raise RuntimeError("External access-only Codex lease is unavailable") from None
+        finally:
+            for descriptor in (auth, lock, directory):
+                if descriptor is not None:
+                    os.close(descriptor)
 
