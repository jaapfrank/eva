ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN ["/usr/local/bin/python", "-B", "-c", "from pathlib import Path;import hashlib;plan={'/opt/eva/src/eva/adapters/connectors/mcp_gateway.py': {'before': 'b92d60415a7118bbaa39f1cea1da7215cdb77b8b6aac0dcee72d43cbc0ae9662', 'after': '2ecf87f86700c552d775c75e32c8147a8510358281fcff10a28ffa3449afab67'}, '/opt/eva/src/eva/adapters/connectors/mcp_filesystem_contract.py': {'before': None, 'after': '77a85cf147733d1904d061777fe313bc8773fd0136718b4751e9cd2a65d10079'}, '/opt/eva/src/eva/providers/mcp_gateway.py': {'before': 'a3323a96b6c5305b36a4856f9a8cb2dba8f6c23be023dc0ea9a345a26fd4802b', 'after': '6b4054d4df53e85a4a96daae7a908043ba639b4171ca2cd9a76790a8796b85be'}};assert all((not Path(p).exists()) if v['before'] is None else hashlib.sha256(Path(p).read_bytes()).hexdigest()==v['before'] for p,v in plan.items()),'Unexpected baseline source; refuse overlay'"]
COPY src/eva/adapters/connectors/mcp_gateway.py /opt/eva/src/eva/adapters/connectors/mcp_gateway.py
COPY src/eva/adapters/connectors/mcp_filesystem_contract.py /opt/eva/src/eva/adapters/connectors/mcp_filesystem_contract.py
COPY src/eva/providers/mcp_gateway.py /opt/eva/src/eva/providers/mcp_gateway.py
RUN ["/usr/local/bin/python", "-B", "-c", "from pathlib import Path;import hashlib;plan={'/opt/eva/src/eva/adapters/connectors/mcp_gateway.py': {'before': 'b92d60415a7118bbaa39f1cea1da7215cdb77b8b6aac0dcee72d43cbc0ae9662', 'after': '2ecf87f86700c552d775c75e32c8147a8510358281fcff10a28ffa3449afab67'}, '/opt/eva/src/eva/adapters/connectors/mcp_filesystem_contract.py': {'before': None, 'after': '77a85cf147733d1904d061777fe313bc8773fd0136718b4751e9cd2a65d10079'}, '/opt/eva/src/eva/providers/mcp_gateway.py': {'before': 'a3323a96b6c5305b36a4856f9a8cb2dba8f6c23be023dc0ea9a345a26fd4802b', 'after': '6b4054d4df53e85a4a96daae7a908043ba639b4171ca2cd9a76790a8796b85be'}};assert all(hashlib.sha256(Path(p).read_bytes()).hexdigest()==v['after'] for p,v in plan.items()),'Overlay source mismatch'"]
