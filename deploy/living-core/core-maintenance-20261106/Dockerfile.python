ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS installed
FROM python@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS runtime-builder
COPY --from=installed /usr/local/lib/python3.12/site-packages/eva2_living_core-0.0.0.dist-info/ /application-dist-info/
COPY --from=installed /opt/eva/full-dependency-upgrade.json /dependency-proof.json
COPY vendor-runtime.json prepare-runtime.py /build/
RUN ["/usr/local/bin/python", "/build/prepare-runtime.py"]
FROM installed
USER 0:0
COPY old-runtime.json cleanup-runtime.py /build/
RUN ["/usr/local/bin/python", "/build/cleanup-runtime.py"]
COPY --from=runtime-builder /runtime/ /
COPY --from=runtime-builder /application-dist-info/ /usr/local/lib/python3.12/site-packages/eva2_living_core-0.0.0.dist-info/
COPY --from=runtime-builder /dependency-proof-current.json /opt/eva/full-dependency-upgrade.json
COPY --from=runtime-builder /python-runtime-upgrade.json /opt/eva/python-runtime-upgrade.json
COPY pyproject.toml /opt/eva/pyproject.toml
COPY runtime_image_update.py /opt/eva/src/eva/operations/runtime_image_update.py
USER 65532:65532
