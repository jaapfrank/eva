# Eva - actieve runtimeconfiguratie
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

WEB_HOST=127.0.0.1
WEB_PORT=3210
EVA_WEB_TOKEN=
EVA_WEB_SENDER=Jaap
# Optioneel: zichtbare naam en identiteit van deze installatie.
EVA_NAME=Eva
EVA_IDENTITY=de vaste digitale huisgenoot van Jaap en zijn gezin

OPENAI_API_KEY=
EVA_MODEL=gpt-5.6-sol
EVA_MODEL_VOICE=gpt-5.6-terra
EVA_MODEL_RESEARCH=gpt-5.6-terra
EVA_REASONING=low
EVA_REASONING_CHAT=none
EVA_REASONING_VOICE=low
EVA_REASONING_AUTONOMY=low
EVA_REASONING_CODE=high

EVA_BRAIN_URL=http://127.0.0.1:3220
EVA_DATA_DIR=./data
TZ=Europe/Amsterdam
EVA_AUTONOMOUS_LLM_TIMEOUT_MS=90000
EVA_AUTONOMY_LEVEL=full
EVA_AUTONOMY_INTERVAL_MINUTES=15
EVA_AUTONOMY_CONVERSATION_PAUSE_MINUTES=2
EVA_AUTONOMY_DAILY_WORK_MINUTES=120
EVA_AUTONOMY_TURN_MINUTES=30
EVA_ACTIVE_WORK_INTERVAL_MINUTES=10
EVA_PROGRESS_WORK_INTERVAL_MINUTES=0.25
EVA_AUTONOMY_TEMPERATURE_DELTA=1
EVA_AUTONOMY_OPEN_EXPLORATION=true
EVA_AUTONOMY_CODE_EXECUTION=true
SLEEP_START=23:30
WAKE_TIME=07:30
ALLOW_HOME_CONTROL=true
EVA_HOUSEHOLD_MEMBERS=
EVA_TRUST_HA_PERSON_MEMBERSHIP=false

# Valetudo/robotintegratie
EVA_ROBOT_URL=
EVA_ROBOT_ENTITY_ID=
EVA_ROBOT_MAP_CAMERA_ID=
EVA_ROBOT_CAMERA_STREAM=

# Omroepen gaan uitsluitend via deze Assist satellites. Formaat:
# alias=assist_satellite.entity_id,alias2=assist_satellite.entity_id
EVA_VOICE_ASSIST_SATELLITES=
EVA_VOICE_ASSIST_SATELLITE_DEFAULT=

# Protect-events worden intern gezien. Alleen deurbel, een bekend gezicht na de
# rusttijd of een werkelijk leerbaar onbekend gezicht kan een melding worden.
EVA_CAMERA_REPORT_QUIET_MINUTES=10
EVA_CAMERA_INCIDENT_QUIET_MS=15000
EVA_DOORBELL_INCIDENT_QUIET_MS=3000
EVA_TRIGGER_FRAME_MAX_FILES=2500
EVA_TRIGGER_FRAME_RETENTION_HOURS=24
EVA_PHOTO_ARCHIVE_DAYS=14
EVA_PHOTO_ARCHIVE_MAX=500

UNIFI_API_KEY=
UNIFI_HOST=
